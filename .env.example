# Veritas AI Environment Configurations Template

# App Settings
APP_NAME=Veritas-AI
ENV=development
DEBUG=true

# Security
JWT_SECRET=supersecretjwtkeyforveritasaiplatform2026!

# PostgreSQL Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=veritas_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis Cache
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Qdrant Vector DB
QDRANT_HOST=localhost
QDRANT_PORT=6333

# Gemini API Key
GEMINI_API_KEY=

# Local LLM (Ollama) Toggles
LLM_PROVIDER=gemini
OLLAMA_MODEL=qwen2.5-coder:1.5b
OLLAMA_BASE_URL=http://localhost:11434

# AWS S3 Storage Driver Options (Optional fallback: local storage)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_S3_REGION=us-east-1

# LangSmith Observability Configuration (Optional)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=Veritas AI
